{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "portal": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "bindings": [
        {
          "type": "service",
          "service": "rankchecker",
          "format": "url",
          "env": "RANKCHECKER_URL"
        }
      ]
    },
    "rankchecker": {
      "root": "rankchecker",
      "framework": "vite",
      "buildCommand": "VITE_BASE_PATH=/rankchecker/ npm run build",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/rankchecker",
      "destination": {
        "service": "rankchecker",
        "path": "/index.html"
      }
    },
    {
      "source": "/rankchecker/api/(.*)",
      "destination": {
        "service": "rankchecker",
        "path": "/api/index"
      }
    },
    {
      "source": "/rankchecker/:path*",
      "destination": {
        "service": "rankchecker",
        "path": "/:path*"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "portal",
        "path": "/api/index"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "portal"
      }
    }
  ]
}
