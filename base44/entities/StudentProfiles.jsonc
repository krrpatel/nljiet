{
  "name": "StudentProfiles",
  "type": "object",
  "properties": {
    "enrollment_number": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "octopod_application_id": {
      "type": "string"
    },
    "octopod_student_id": {
      "type": "string"
    },
    "academy_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "uid_number": {
      "type": "string"
    },
    "medium_id": {
      "type": "string"
    },
    "standard_id": {
      "type": "string"
    },
    "division_id": {
      "type": "string"
    },
    "academic_year_id": {
      "type": "string"
    },
    "current_year": {
      "type": "string"
    },
    "overall_outstanding": {
      "type": "number"
    }
  },
  "required": [
    "enrollment_number",
    "email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}