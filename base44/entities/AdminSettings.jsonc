      "type": "string"
    },
    "whatsapp_enabled": {
      "type": "boolean"
    },
    "support_message": {
      "type": "string"
    },
    "minimum_attendance_percentage": {
      "type": "number"
    },
    "current_academic_year_id": {
      "type": "string"
    },
    "active_semester": {
      "type": "integer"
    },
    "updated_by": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
