{
  "name": "ResultUploads",
  "type": "object",
  "properties": {
    "branch": {
      "type": "string"
    },
    "semester": {
      "type": "integer"
    },
    "academic_year_id": {
      "type": "string"
    },
    "subject_id": {
      "type": "string"
    },
    "subject_code": {
      "type": "string"
    },
    "exam_type": {
      "type": "string"
    },
    "exam_number": {
      "type": "integer"
    },
    "pdf_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "done",
        "error"
      ],
      "default": "pending"
    },
    "records_imported": {
      "type": "integer",
      "default": 0
    },
    "error_message": {
      "type": "string"
    },
    "uploaded_by": {
      "type": "string"
    },
    "processed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "branch",
    "semester",
    "exam_type"
  ]
}