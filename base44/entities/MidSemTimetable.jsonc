{
  "name": "MidSemTimetable",
  "type": "object",
  "properties": {
    "exam_number": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "subject_id": {
      "type": "string"
    },
    "subject_code": {
      "type": "string"
    },
    "subject_name": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "semester": {
      "type": "integer"
    },
    "academic_year_id": {
      "type": "string"
    },
    "exam_date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "venue": {
      "type": "string"
    },
    "syllabus_pdf_url": {
      "type": "string"
    },
    "is_completed": {
      "type": "boolean",
      "default": false
    },
    "published": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "exam_number",
    "subject_id",
    "branch",
    "semester",
    "exam_date"
  ]
}