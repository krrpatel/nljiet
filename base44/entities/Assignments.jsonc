{
  "name": "Assignments",
  "type": "object",
  "properties": {
    "subject_id": {
      "type": "string"
    },
    "semester": {
      "type": "integer"
    },
    "academic_year_id": {
      "type": "string"
    },
    "assignment_number": {
      "type": "integer"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "attachment_path": {
      "type": "string"
    },
    "published": {
      "type": "boolean"
    }
  },
  "required": [
    "subject_id",
    "assignment_number",
    "title",
    "deadline"
  ]
}