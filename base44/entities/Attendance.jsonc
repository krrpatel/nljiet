{
  "name": "Attendance",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string"
    },
    "enrollment_number": {
      "type": "string"
    },
    "subject_id": {
      "type": "string"
    },
    "academic_year_id": {
      "type": "string"
    },
    "semester": {
      "type": "integer"
    },
    "week_start": {
      "type": "string",
      "format": "date"
    },
    "week_end": {
      "type": "string",
      "format": "date"
    },
    "conducted_lectures": {
      "type": "integer"
    },
    "attended_lectures": {
      "type": "integer"
    }
  },
  "required": [
    "student_id",
    "subject_id",
    "conducted_lectures",
    "attended_lectures"
  ]
}